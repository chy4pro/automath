--- L=3, nu=2: every admissible step-(p+1) shape and its step count (reductio needs exactly 3)
  E=0 C=(3, 3, 3, 3) A'=(4,) steps=3  <== clears in exactly L
  E=0 C=(3, 3, 3, 3) A'=(3, 1) steps=4
  E=0 C=(3, 3, 3, 3) A'=(2, 2) steps=4
  E=0 C=(3, 3, 3, 3) A'=(2, 1, 1) steps=4
  E=0 C=(3, 3, 3, 3) A'=(1, 1, 1, 1) steps=5
  E=1 C=(4, 3, 3, 3) A'=(3,) steps=3  <== clears in exactly L
  E=1 C=(4, 3, 3, 3) A'=(2, 1) steps=4
  E=1 C=(4, 3, 3, 3) A'=(1, 1, 1) steps=4
  E=2: excluded by Lemma FAN-8' (needs L <= 2nu-E = 2)
  E=3: excluded by Lemma FAN-8' (needs L <= 2nu-E = 1)
  E=4: excluded by Lemma FAN-8' (needs L <= 2nu-E = 0)
--- L=4, nu=2: every admissible step-(p+1) shape and its step count (reductio needs exactly 4)
  E=0 C=(4, 4, 4, 4, 4) A'=(4,) steps=4  <== clears in exactly L
  E=0 C=(4, 4, 4, 4, 4) A'=(3, 1) steps=5
  E=0 C=(4, 4, 4, 4, 4) A'=(2, 2) steps=5
  E=0 C=(4, 4, 4, 4, 4) A'=(2, 1, 1) steps=5
  E=0 C=(4, 4, 4, 4, 4) A'=(1, 1, 1, 1) steps=6
  E=1: excluded by Lemma FAN-8' (needs L <= 2nu-E = 3)
  E=2: excluded by Lemma FAN-8' (needs L <= 2nu-E = 2)
  E=3: excluded by Lemma FAN-8' (needs L <= 2nu-E = 1)
  E=4: excluded by Lemma FAN-8' (needs L <= 2nu-E = 0)
--- L=5, nu=2: every admissible step-(p+1) shape and its step count (reductio needs exactly 5)
  E=0 C=(5, 5, 5, 5, 5, 5) A'=(4,) steps=5  <== clears in exactly L
  E=0 C=(5, 5, 5, 5, 5, 5) A'=(3, 1) steps=6
  E=0 C=(5, 5, 5, 5, 5, 5) A'=(2, 2) steps=6
  E=0 C=(5, 5, 5, 5, 5, 5) A'=(2, 1, 1) steps=6
  E=0 C=(5, 5, 5, 5, 5, 5) A'=(1, 1, 1, 1) steps=7
  E=1: excluded by Lemma FAN-8' (needs L <= 2nu-E = 3)
  E=2: excluded by Lemma FAN-8' (needs L <= 2nu-E = 2)
  E=3: excluded by Lemma FAN-8' (needs L <= 2nu-E = 1)
  E=4: excluded by Lemma FAN-8' (needs L <= 2nu-E = 0)
